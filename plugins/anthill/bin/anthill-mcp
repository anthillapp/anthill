#!/usr/bin/env node
/**
 * Find the Anthill MCP server, and say so plainly when it cannot be found.
 *
 * Where the plugin runs from depends on how it was installed, so it cannot
 * reach anything outside itself by a relative path. Installed from a local
 * marketplace, `CLAUDE_PLUGIN_ROOT` is the checkout's own `plugins/anthill`,
 * and `../../apps/mcp/dist/server.js` would in fact resolve — but the same
 * plugin fetched from a git marketplace is a copy of this directory and nothing
 * else, where that path climbs out of the plugin into whatever happens to be
 * above it. A path that works only under one of the two is worse than no path,
 * because it works for whoever wrote it.
 *
 * So the plugin carries its own copy of the server, in server/anthill-mcp.mjs
 * beside this script (scripts/build-plugin-server.mjs writes it), and a server
 * anywhere else is located absolutely, by a path somebody gives us.
 *
 * Four places are looked at, in this order. The first three are something a
 * person chose, for running a checkout's own build; the last is what every
 * plugin installed from a marketplace or a directory runs:
 *
 *   ANTHILL_MCP_SERVER   the built server.js itself
 *   ANTHILL_REPO         a checkout; the server is at apps/mcp/dist/server.js
 *   ~/.anthill/plugin.json   {"server": "/abs/path/to/server.js"}
 *   server/anthill-mcp.mjs   the copy inside this plugin
 *
 * A stdio MCP server may write nothing to stdout but the protocol, so a failure
 * is reported on stderr and the process exits non-zero. The host then shows the
 * server as failed, which is the honest outcome: a server that cannot be found
 * is not a server that answers "no".
 */

import { spawn } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, isAbsolute, join } from "node:path";
import { fileURLToPath } from "node:url";

/** This plugin's own folder: bin/ is one level below it. */
const PLUGIN_ROOT = dirname(dirname(fileURLToPath(import.meta.url)));

/** The copy of the server this plugin carries. */
const BUNDLED = join(PLUGIN_ROOT, "server", "anthill-mcp.mjs");

/** The one file that is the server, wherever it was found. */
function fromEnvironment() {
  const direct = process.env.ANTHILL_MCP_SERVER?.trim();
  if (direct) return { path: direct, source: "ANTHILL_MCP_SERVER" };

  const repo = process.env.ANTHILL_REPO?.trim();
  if (repo) {
    return { path: join(repo, "apps", "mcp", "dist", "server.js"), source: "ANTHILL_REPO" };
  }
  return undefined;
}

/** The settings file, read defensively: a damaged one is no answer, not a crash. */
function fromSettings() {
  const file = join(homedir(), ".anthill", "plugin.json");
  if (!existsSync(file)) return undefined;
  try {
    const parsed = JSON.parse(readFileSync(file, "utf8"));
    const server = typeof parsed?.server === "string" ? parsed.server.trim() : "";
    return server ? { path: server, source: file } : undefined;
  } catch {
    return { problem: `${file} could not be read as JSON.` };
  }
}

function fromPlugin() {
  return existsSync(BUNDLED) ? { path: BUNDLED, source: "this plugin" } : undefined;
}

function locate() {
  const found = fromEnvironment() ?? fromSettings() ?? fromPlugin();
  if (!found) {
    return { problem: `Nothing says where the Anthill MCP server is, and this plugin's own copy (${BUNDLED}) is missing. Reinstall the plugin.` };
  }
  if ("problem" in found) return found;
  if (!isAbsolute(found.path)) {
    return { problem: `${found.source} gives a relative path (${found.path}); it has to be absolute, because this process starts in whatever directory the host happened to be in.` };
  }
  if (!existsSync(found.path)) {
    return { problem: `${found.source} points at ${found.path}, and there is no file there. If this is a checkout, the server has to be built first: npm run build:deps && npm run build --workspace=@anthill/mcp` };
  }
  return found;
}

const located = locate();
if ("problem" in located) {
  process.stderr.write(
    `anthill plugin: ${located.problem}\n` +
      "Set one of these and restart the session:\n" +
      "  ANTHILL_MCP_SERVER=/abs/path/to/anthill/apps/mcp/dist/server.js\n" +
      "  ANTHILL_REPO=/abs/path/to/anthill\n" +
      `  ${join(homedir(), ".anthill", "plugin.json")}  {"server": "/abs/path/to/.../server.js"}\n`,
  );
  process.exit(78); // EX_CONFIG: the configuration is wrong, not the program.
}

/**
 * The version this installed copy of the plugin is, and which harness it is for.
 *
 * Read from the manifest beside this script, because this script is the one
 * part of the installed copy that runs every session. A copy installed from a
 * directory is never refreshed on its own, and the server compares what it is
 * told here with its own version and says so when they differ (ANT-120). A
 * manifest that cannot be read tells the server nothing, which it takes as
 * nothing to report.
 */
function installedPlugin() {
  const root = PLUGIN_ROOT;
  for (const [dir, host] of [[".claude-plugin", "claude-code"], [".codex-plugin", "codex"]]) {
    try {
      const manifest = JSON.parse(readFileSync(join(root, dir, "plugin.json"), "utf8"));
      if (typeof manifest?.version === "string") return { version: manifest.version, host };
    } catch {
      // Not this harness's manifest; try the other.
    }
  }
  return undefined;
}

const plugin = installedPlugin();

// Arguments are passed through, so a data directory can be given in .mcp.json
// without this script having to know what the server's flags mean. The
// plugin's version travels in the child's environment rather than as a flag:
// the server refuses flags it does not know, and an older server started by a
// newer launcher must still start.
const child = spawn(process.execPath, [located.path, ...process.argv.slice(2)], {
  stdio: "inherit",
  windowsHide: true,
  env: {
    ...process.env,
    ...(plugin ? { ANTHILL_PLUGIN_VERSION: plugin.version, ANTHILL_PLUGIN_HOST: plugin.host } : {}),
  },
});
for (const signal of ["SIGTERM", "SIGINT", "SIGHUP"]) {
  process.on(signal, () => {
    try {
      child.kill(signal);
    } catch {
      // The child is already gone, which is what we were asking for.
    }
  });
}
child.on("exit", (code, signal) => {
  if (signal) {
    process.removeAllListeners(signal);
    try {
      process.kill(process.pid, signal);
    } catch {
      process.exit(1);
    }
  } else {
    process.exit(code ?? 0);
  }
});
