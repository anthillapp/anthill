{
  "name": "@anthill/cli",
  "version": "0.8.8",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Anthill as a CLI that opens the app as a web interface on 127.0.0.1. Supported on macOS and Linux; experimental and unsupported on Windows.",
  "main": "out/cli/src/cli.js",
  "bin": {
    "anthill": "out/cli/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.19.4",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@sentry/node": "10.75.0",
    "posthog-node": "~5.54.1"
  }
}
