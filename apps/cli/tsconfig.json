{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "out",
    "types": ["node"]
  },
  "include": [
    "src/cli.ts",
    "src/server.ts",
    "src/bridge.ts",
    "src/paths.ts",
    "src/report.ts",
    "../desktop/src/main/live/hook-handler.ts"
  ]
}
